DATABASE_URL="your-database-connection-string"
FRONTEND_URL="http://localhost:3000"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
FROM_EMAIL="your-email@gmail.com"
FROM_NAME="SmartAcademy Portal"
REPLY_TO_EMAIL="your-email@gmail.com"
R2_BUCKET_NAME="your-r2-bucket"
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_REGION="auto"
R2_PUBLIC_BASE_URL="https://your-public-r2-domain.example.com"
CLOUDFLARE_STREAM_ACCOUNT_ID="your-cloudflare-stream-account-id"
CLOUDFLARE_STREAM_API_TOKEN="your-cloudflare-stream-api-token"
ACCESS_TOKEN_SECRET="replace-with-a-long-random-secret"
ACCESS_TOKEN_EXPIRY="1d"
REFRESH_TOKEN_SECRET="replace-with-a-different-long-random-secret"
REFRESH_TOKEN_EXPIRY="2d"
ADMIN_NAME="System Administrator"
ADMIN_EMAIL="admin@smartacademy.com"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"

# AI Tutor (RAG) - use Groq (free) or OpenAI
GROQ_API_KEY="your-groq-api-key"
GROQ_CHAT_MODEL="openai/gpt-oss-120b"
GROQ_EMBEDDING_MODEL="nomic-embed-text-v1.5"
OPENAI_API_KEY="your-openai-api-key"
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Speech-to-text (Whisper) for uploaded videos - reuses GROQ_API_KEY / OPENAI_API_KEY
# Long recordings are auto-chunked to stay within provider limits.
GROQ_WHISPER_MODEL="whisper-large-v3"
OPENAI_WHISPER_MODEL="whisper-1"

# Smart Recommendation ML service (FastAPI, server/src/ml/service)
ML_SERVICE_URL="http://127.0.0.1:8005"
ML_SERVICE_TIMEOUT_MS="5000"

# HLS video processing (defaults to ffmpeg/ffprobe on PATH)
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
